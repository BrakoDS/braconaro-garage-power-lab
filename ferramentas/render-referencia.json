  "aluno.plano.iniciante": "<div class=\"td-card\">\n    <div class=\"td-head\"><span class=\"td-dia\">Segunda</span><h3>Hipertrofia</h3><span class=\"td-nivel\">seu nível: Iniciante</span></div>\n    <div class=\"td-parte-h\">Aquecimento / Mobilidade</div><ul class=\"td-lista\"><li>Mobilidade — <b>60s</b></li></ul><ul class=\"td-lista\"><li class=\"td-ex\">\n      <span class=\"td-ex-nome\">1. Supino</span>\n      <span class=\"td-ex-sub\">Empurrar</span>\n      <span class=\"td-ex-presc\"><b>3×</b> 10 · leve</span>\n    </li></ul>\n  </div>",
  "aluno.livre.iniciante": "<div class=\"td-card\">\n    <div class=\"td-head\"><span class=\"td-dia\">Terça</span><h3>Hipertrofia</h3><span class=\"td-nivel\">seu nível: Iniciante</span></div>\n    <div class=\"td-parte-h\">A</div><ul class=\"td-lista\"><li class=\"td-grupo\">\n    <div class=\"td-grupo-cab\">\n      <span class=\"td-grupo-rotulo\">Bi-set</span>\n      <span class=\"td-ex-presc\"><b>3×</b> 10 · 60s</span>\n    </div>\n    <div class=\"td-grupo-membros\"><span class=\"td-ex-sub\">Supino reto no Smith · ≈ 20 kg total na barra</span><span class=\"td-ex-sub\">Supino inclinado no Smith · ≈ 20 kg total na barra</span></div>\n    <span class=\"td-ex-sub td-biset-vs\">↕ alterna com a parceira a cada série</span>\n  </li><li class=\"td-ex\">\n    <span class=\"td-ex-nome\">3. Supino reto com halteres</span>\n    <span class=\"td-ex-sub\">Empurrar</span>\n    <span class=\"td-ex-presc\"><b>3×</b> 10 · ≈ 6 kg por mão (halteres) · 60s</span>\n  </li></ul><div class=\"td-parte-h\">WOD — EMOM · 16 min</div>\n    <div class=\"td-nota\">A cada minuto, um movimento na ordem — a lista reinicia até fechar o tempo.</div>\n    <div class=\"td-nota\">8 voltas completas de rotação em 16 min.</div>\n    <ul class=\"td-lista\"><li>min 1. Supino inclinado com halteres — 12 reps</li><li>min 2. Crucifixo com halteres — 200m</li></ul>\n  </div>",
  "aluno.livreAntigo.iniciante": "<div class=\"td-card\">\n    <div class=\"td-head\"><span class=\"td-dia\">Quarta</span><h3>Força</h3><span class=\"td-nivel\">seu nível: Iniciante</span></div>\n    <div class=\"td-parte-h\">Bloco 1</div><ul class=\"td-lista\"><li class=\"td-ex\">\n    <span class=\"td-ex-nome\">1. Agachamento</span>\n    <span class=\"td-ex-sub\">Quadríceps</span>\n    <span class=\"td-ex-presc\"><b>3×</b> 8 · leve · 90s</span>\n  </li></ul>\n  </div>",
  "aluno.hibrido.iniciante": "<div class=\"td-card\">\n    <div class=\"td-head\"><span class=\"td-dia\">Quinta</span><h3>Híbrido</h3><span class=\"td-nivel\">seu nível: Iniciante</span></div>\n    <div class=\"td-nota\">Acúmulo</div>\n    <div class=\"td-parte-h\">Mobilidade — 4 min</div>\n    <ul class=\"td-lista\"><li>Agachamento livre (peso corporal)</li><li>Tríceps overhead dinâmico</li><li>Face pull na corda</li></ul>\n    <div class=\"td-parte-h\">Hipertrofia — bi-sets em dupla</div>\n    <ul class=\"td-lista\"><li class=\"td-ex td-posto\">\n      <span class=\"td-ex-nome\">Posto 1 — Peito / Costas</span>\n      <span class=\"td-ex-sub\"><span class=\"td-ex-nome\">Supino reto com halteres</span></span>\n      <span class=\"td-ex-sub td-biset-vs\">↕ bi-set — alterna com a parceira a cada série</span>\n      <span class=\"td-ex-sub\"><span class=\"td-ex-nome\">Puxada aberta neutra (monocross)</span></span>\n      <span class=\"td-ex-presc\"><b>3×</b> 10 reps · 60s de pausa</span>\n      <div class=\"td-ex-sub\"><i>Tempo 2-1-2</i></div>\n    </li><li class=\"td-ex td-posto\">\n      <span class=\"td-ex-nome\">Posto 2 — Quadríceps / Posterior-glúteo</span>\n      <span class=\"td-ex-sub\"><span class=\"td-ex-nome\">Agachamento no TRX</span></span>\n      <span class=\"td-ex-sub td-biset-vs\">↕ bi-set — alterna com a parceira a cada série</span>\n      <span class=\"td-ex-sub\"><span class=\"td-ex-nome\">Mesa flexora</span></span>\n      <span class=\"td-ex-presc\"><b>3×</b> 10 reps · 60s de pausa</span>\n      <div class=\"td-ex-sub\"><i>Drop-set</i></div>\n    </li><li class=\"td-ex td-posto\">\n      <span class=\"td-ex-nome\">Posto 3 — Bíceps / Tríceps</span>\n      <span class=\"td-ex-sub\"><span class=\"td-ex-nome\">Rosca Scott</span></span>\n      <span class=\"td-ex-sub td-biset-vs\">↕ bi-set — alterna com a parceira a cada série</span>\n      <span class=\"td-ex-sub\"><span class=\"td-ex-nome\">Tríceps mergulho no banco</span></span>\n      <span class=\"