  "aluno.plano.intermediario": "<div class=\"td-card\">\n    <div class=\"td-head\"><span class=\"td-dia\">Segunda</span><h3>Hipertrofia</h3><span class=\"td-nivel\">seu nível: Intermediário</span></div>\n    <div class=\"td-parte-h\">Aquecimento / Mobilidade</div><ul class=\"td-lista\"><li>Mobilidade — <b>60s</b></li></ul><ul class=\"td-lista\"><li class=\"td-ex\">\n      <span class=\"td-ex-nome\">1. Supino</span>\n      <span class=\"td-ex-sub\">Empurrar</span>\n      <span class=\"td-ex-presc\"><b>4×</b> 10 · média</span>\n    </li></ul>\n  </div>",
  "aluno.livre.intermediario": "<div class=\"td-card\">\n    <div class=\"td-head\"><span class=\"td-dia\">Terça</span><h3>Hipertrofia</h3><span class=\"td-nivel\">seu nível: Intermediário</span></div>\n    <div class=\"td-parte-h\">A</div><ul class=\"td-lista\"><li class=\"td-grupo\">\n    <div class=\"td-grupo-cab\">\n      <span class=\"td-grupo-rotulo\">Bi-set</span>\n      <span class=\"td-ex-presc\"><b>3×</b> 10 · 60s</span>\n    </div>\n    <div class=\"td-grupo-membros\"><span class=\"td-ex-sub\">Supino reto no Smith · ≈ 35 kg total na barra</span><span class=\"td-ex-sub\">Supino inclinado no Smith · ≈ 35 kg total na barra</span></div>\n    <span class=\"td-ex-sub td-biset-vs\">↕ alterna com a parceira a cada série</span>\n  </li><li class=\"td-ex\">\n    <span class=\"td-ex-nome\">3. Supino reto com halteres</span>\n    <span class=\"td-ex-sub\">Empurrar</span>\n    <span class=\"td-ex-presc\"><b>3×</b> 10 · ≈ 9 kg por mão (halteres) · 60s</span>\n  </li></ul><div class=\"td-parte-h\">WOD — EMOM · 16 min</div>\n    <div class=\"td-nota\">A cada minuto, um movimento na ordem — a lista reinicia até fechar o tempo.</div>\n    <div class=\"td-nota\">8 voltas completas de rotação em 16 min.</div>\n    <ul class=\"td-lista\"><li>min 1. Supino inclinado com halteres — 12 reps</li><li>min 2. Crucifixo com halteres — 200m</li></ul>\n  </div>",
