rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Só imagens e no máximo 5 MB por arquivo. `request.resource == null` é uma
    // EXCLUSÃO (delete não envia recurso) — liberada; o limite vale só no upload.
    // Evita que uma conta autenticada suba arquivos gigantes/de qualquer tipo
    // (proteção de custo no plano Blaze). Todos os uploads do app são WebP.
    function uploadImagemValido() {
      return request.resource == null
        || (request.resource.size < 5 * 1024 * 1024
          && request.resource.contentType.matches('image/.*'));
    }

    // O coach: a MESMA lista fixa de UIDs do firestore.rules (ver o comentário
    // de `ehCoach` lá). Antes, esta regra perguntava ao Firestore se existia
    // gestao/{uid}, e qualquer aluno podia criar esse documento para si. As duas
    // listas precisam andar juntas: coach novo entra nos dois arquivos.
    function ehCoach() {
      return request.auth != null
        && request.auth.uid in ['G6gfpahorCfptVxOM26sCjxMOqb2'];
    }

    // O aluno dono da pasta: o e-mail logado é o da pasta. O mesmo
    // `ehAlunoDono` do firestore.rules, com o e-mail em minúsculas dos dois lados.
    function ehAlunoDono(email) {
      return request.auth != null && request.auth.token.email.lower() == email.lower();
    }

    // Mídia do chat, nos tetos de LIMITES_MIDIA (app-mobile, core/chat.ts —
    // os dois têm de andar juntos): foto até 5 MB, voz até 10 MB, vídeo até
    // 50 MB. O nome segue o do app, {timestamp}_{tipo}.{ext}, com a capa do
    // vídeo em {timestamp}_capa.jpg, e não há subpasta: a pasta não vira depósito.
    function midiaChatValida(arquivo) {
      return arquivo.matches('[0-9]+_(imagem|video|audio|capa)[.][a-z0-9]{2,4}')
        && ((request.resource.contentType.matches('image/.*')
            && request.resource.size <= 5 * 1024 * 1024)
          || (request.resource.contentType.matches('audio/.*')
            && request.resource.size <= 10 * 1024 * 1024)
          || (request.resource.contentType.matches('video/.*')
            && request.resource.size <= 50 * 1024 * 1024));
    }

    // Chat Coach ↔ Aluno (Etapa 17.2) — fotos, vídeos (e capas) e vozes da
    // conversa, em chats/{email}/{arquivo}; a mensagem no Firestore guarda o
    // download URL.
    //  - o ALUNO dono e o COACH (ehCoach) leem e apagam — os dois lados apagam
    //    a mensagem, e "Limpar conversa" esvazia a pasta (listAll + delete);
    //  - os dois sobem arquivo novo, e só novo: sem `update`, ninguém troca o
    //    arquivo por trás de uma mensagem que já saiu (o nome tem o timestamp).
    match /chats/{email}/{arquivo} {
      allow read, delete: if ehAlunoDono(email) || ehCoach();
      allow create: if (ehAlunoDono(email) || ehCoach()) && midiaChatValida(arquivo);
    }

    // Fotos da Gestão de Alunos — só o coach, e só na própria pasta
    match /gestao/{uid}/{allPaths=**} {
      allow read: if ehCoach() && request.auth.uid == uid;
      allow write: if ehCoach() && request.auth.uid == uid
        && uploadImagemValido();
    }

    // Fotos das refeições enviadas pelo aluno (Garage App, controle nutricional).
    // Uma por refeição, em nutricao/{email}/{mealId}.jpg — fora do Firestore de
    // propósito: o doc nutricao/{email} tem teto de 1 MB e guarda 90 dias de
    // refeições, então imagem lá dentro estouraria o histórico.
    //  - o ALUNO lê/grava só a própria pasta;
    //  - o COACH (ehCoach) lê, para orientar a dieta.
    match /nutricao/{email}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.token.email.lower() == email.lower();
      allow write: if request.auth != null && request.auth.token.email.lower() == email.lower()
        && uploadImagemValido();
      allow read: if ehCoach();
    }

    // Diário de Evolução (app mobile) — uma foto por dia, em
    // diario/{email}/{dia}.webp e a miniatura em diario/{email}/{dia}_mini.webp.
    // Mais apertado que `uploadImagemValido`: só WebP (é o que o app gera) e
    // menos de 1 MB (a foto cheia fica em ~150–250 KB). O nome é preso ao
    // formato do dia e não há subpasta, então a pasta não vira depósito.
    //  - o ALUNO grava/refaz/apaga só a própria pasta;
    //  - o COACH (ehCoach) só lê.
    match /diario/{email}/{arquivo} {
      allow read: if (request.auth != null && request.auth.token.email.lower() == email.lower())
        || ehCoach();
      allow create, update: if request.auth != null && request.auth.token.email.lower() == email.lower()
        && arquivo.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}(_mini)?[.]webp')
        && request.resource.size < 1024 * 1024
        && request.resource.contentType == 'image/webp';
      allow delete: if request.auth != null && request.auth.token.email.lower() == email.lower();
    }

    // Foto de perfil enviada pelo próprio aluno (Portal do Aluno).
    // Só o aluno cujo e-mail logado bate com a pasta pode ler/gravar.
    match /portal/{email}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.token.email.lower() == email.lower();
      allow write: if request.auth != null && request.auth.token.email.lower() == email.lower()
        && uploadImagemValido();
    }
  }
}
