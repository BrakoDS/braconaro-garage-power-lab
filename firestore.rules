rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // QUEM É O COACH
    // ============================================================
    // O coach é uma LISTA FIXA de UIDs, escrita aqui. Não é mais "quem tem um
    // documento gestao/{uid}": essa condição era auto-provisionável. A regra de
    // gestao/{uid} deixava qualquer conta logada criar o PRÓPRIO documento, e a
    // partir daí ela passava a valer como coach em todas as outras regras. Ou
    // seja, qualquer aluno podia ler a nutrição, o consentimento e a rotina de
    // todos os alunos, e reescrever o portal/{email} de qualquer um.
    //
    // Por que UID e não e-mail: o UID é gerado pelo Firebase Auth, não se escolhe
    // e não se reaproveita. Um e-mail pode ser trocado na conta, ou recadastrado
    // por outra pessoa se a conta for apagada. As Cloud Functions usam a allowlist
    // por e-mail (EMAILS_COACH em functions/src/index.ts), que continua valendo
    // lá. Aqui fica a chave mais forte.
    //
    // Coach novo: acrescente o UID (Firebase Console › Authentication › Users)
    // e publique as regras de teste-hibrido/.
    function ehCoach() {
      return request.auth != null
        && request.auth.uid in ['G6gfpahorCfptVxOM26sCjxMOqb2'];
    }

    // O coach, e só no próprio documento (coaches/{uid}, gestao/{uid}…).
    function ehCoachDono(uid) {
      return ehCoach() && request.auth.uid == uid;
    }

    // Montador de treino — um documento por coach, com o histórico dividido ao
    // lado: `treinos/{YYYY-MM}` (um documento por mês, para não bater no teto de
    // 1 MB) e `arquivo/{nome}` (formato semanal antigo). Regra não desce sozinha
    // para subcoleção, por isso o `{sub=**}` — mesmo dono, mesmo acesso.
    match /coaches/{uid} {
      allow read, write: if ehCoachDono(uid);
      match /{sub=**} {
        allow read, write: if ehCoachDono(uid);
      }
    }

    // Montador individual (o montador novo, em teste ao lado do atual) — mesma
    // forma de `coaches/{uid}`: documento leve e o histórico por mês em
    // `treinos/{YYYY-MM}`. Coleção separada de propósito: durante o teste, os dois
    // montadores não podem disputar o mesmo documento.
    match /montadorIndividual/{uid} {
      allow read, write: if ehCoachDono(uid);
      match /{sub=**} {
        allow read, write: if ehCoachDono(uid);
      }
    }

    // Gestão de alunos — um documento por coach (separado do montador)
    match /gestao/{uid} {
      allow read, write: if ehCoachDono(uid);

      // Log da tela Registros (eventos.js) — subcoleção, e não campo do doc
      // acima: aquele guarda todos os alunos, tem teto de 1 MB e é regravado
      // inteiro a cada mudança. Só o próprio coach lê e escreve.
      match /eventos/{ev} {
        allow read, write: if ehCoachDono(uid);
      }
    }

    // Academia (inventário + catálogo de exercícios) — um documento por coach
    match /academia/{uid} {
      allow read, write: if ehCoachDono(uid);
    }

    // Portal do Aluno — fatia publicada por aluno, em portal/{email}.
    //  - o ALUNO lê apenas o documento cujo id == o e-mail logado dele;
    //  - o COACH (ehCoach) publica/atualiza qualquer um.
    match /portal/{email} {
      allow read: if request.auth != null && request.auth.token.email.lower() == email.lower();
      allow write: if ehCoach();
    }

    // Avisos da Academia — mural único, publicado pelo coach e lido por todos.
    //  - qualquer aluno autenticado LÊ;
    //  - só o COACH (ehCoach) publica.
    match /avisosPortal/{doc} {
      allow read: if request.auth != null;
      allow write: if ehCoach();
    }

    // Ranking do box (gamificação) — doc único publicado pelo coach, lido por todos.
    match /rankingPortal/{doc} {
      allow read: if request.auth != null;
      allow write: if ehCoach();
    }

    // Treino da semana (Montador) — um doc por mês, publicado pelo coach, lido por
    // qualquer aluno autenticado. Só o coach (ehCoach) publica.
    match /treinoPortal/{doc} {
      allow read: if request.auth != null;
      allow write: if ehCoach();
    }

    // Garage Store — vitrine de produtos afiliados, publicada pelo coach.
    //  - leitura PÚBLICA e sem login: a vitrine fica no site, aberta a visitante.
    //    São só produtos (nome, foto, preço, link) — nenhum dado pessoal aqui.
    //  - escrita só do COACH (ehCoach).
    match /lojaPortal/{doc} {
      allow read: if true;
      allow write: if ehCoach();
    }

    // Feed de preços lido do Mercado Livre. Escrito SÓ pela Cloud Function, que
    // usa o Admin SDK e passa por cima das regras — daí o `write: if false`, que
    // fecha a porta para qualquer cliente, inclusive o coach logado. O robô e o
    // coach nunca disputam o mesmo campo: o preço digitado vive no catálogo, o
    // preço lido vive aqui, e a vitrine funde os dois na hora de montar o card.
    match /lojaPrecos/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Desafios da semana — lista única publicada pelo coach, lida por todos.
    match /desafiosPortal/{doc} {
      allow read: if request.auth != null;
      allow write: if ehCoach();
    }

    // Progresso dos desafios por aluno (dias cumpridos + conclusões).
    //  - o ALUNO lê/grava só o seu; o COACH (ehCoach) lê.
    match /desafios/{email} {
      allow read, write: if request.auth != null && request.auth.token.email.lower() == email.lower();
      allow read: if ehCoach();
    }

    // Nutrição Básica — gasto calórico de treino, um doc por aluno.
    //  - o ALUNO lê/grava só o doc do próprio e-mail;
    //  - o COACH (ehCoach) pode ler (acompanhamento).
    match /gastoTreinos/{email} {
      allow read, write: if request.auth != null && request.auth.token.email.lower() == email.lower();
      allow read: if ehCoach();
    }

    // Consentimento LGPD (termo de adesão) — um doc por aluno.
    //  - o ALUNO lê/grava o seu; o COACH (ehCoach) lê (auditoria).
    match /consentimentos/{email} {
      allow read, write: if request.auth != null && request.auth.token.email.lower() == email.lower();
      allow read: if ehCoach();
    }

    // Registro de cargas (carga × reps por exercício) — um doc por aluno.
    //  - o ALUNO lê/grava o seu; o COACH (ehCoach) lê e grava (registrar por ele).
    match /cargas/{email} {
      allow read, write: if request.auth != null && request.auth.token.email.lower() == email.lower();
      allow read, write: if ehCoach();
    }

    // Exceções do treino por aluno (Montador Individual) — um doc por aluno, id ==
    // e-mail, no mesmo padrão de cargas/desafios. Guarda só o que FUGIU da regra
    // naquele dia ("hoje o João faz 2 séries de agachamento"); a versão comum de
    // cada aluno é derivada do perfil, e não fica gravada em lugar nenhum.
    //  - o ALUNO lê a dele (e grava o registro pós-aula dele);
    //  - o COACH (ehCoach) lê e grava todas.
    match /treinoAluno/{email} {
      allow read, write: if request.auth != null && request.auth.token.email.lower() == email.lower();
      allow read, write: if ehCoach();
    }

    // Leads da landing (formulário de aula experimental) — captação pública.
    //  - QUALQUER visitante pode CRIAR um lead (sem login — é a landing), mas
    //    só com os campos e tamanhos esperados (evita lixo/abuso);
    //  - ninguém de fora LÊ, EDITA ou APAGA (nem o próprio autor);
    //  - só o COACH (ehCoach) lê/atualiza/apaga (acompanhar funil).
    match /leads/{id} {
      allow create: if request.resource.data.keys().hasOnly(['nome', 'whatsapp', 'objetivo', 'horario', 'origem', 'status', 'criadoEm', 'indicadoPor'])
        && request.resource.data.nome is string && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() < 100
        && request.resource.data.whatsapp is string && request.resource.data.whatsapp.size() > 0 && request.resource.data.whatsapp.size() < 30
        && request.resource.data.status == 'novo'
        && (!('indicadoPor' in request.resource.data) || (request.resource.data.indicadoPor is string && request.resource.data.indicadoPor.size() < 100));
      allow read, update, delete: if ehCoach();
    }

    // Rotina do aluno (app mobile) — blocos de hábitos e o que já foi concluído
    // em cada dia. Um doc por aluno, id == e-mail (mesmo padrão de desafios/cargas).
    //  - o ALUNO lê/grava só a sua;
    //  - o COACH (ehCoach) lê, para acompanhar a adesão.
    match /rotinas/{email} {
      allow read, write: if request.auth != null && request.auth.token.email.lower() == email.lower();
      allow read: if ehCoach();
    }

    // Controle nutricional (app mobile) — o que o aluno COME: refeições por dia,
    // com calorias e macros. Não confundir com `gastoTreinos`, que é a energia
    // QUEIMADA no treino. Um doc por aluno, id == e-mail (padrão de cargas/rotinas).
    //  - o ALUNO lê/grava só o seu;
    //  - o COACH (ehCoach) lê, para orientar a dieta.
    match /nutricao/{email} {
      allow read, write: if request.auth != null && request.auth.token.email.lower() == email.lower();
      allow read: if ehCoach();
    }

    // Cota diária de análise de foto pelo Coach IA — um doc por aluno.
    //
    // NINGUÉM escreve pelo cliente: só a Cloud Function `analisarRefeicao`, que
    // usa o Admin SDK e passa por cima destas regras. Se o aluno pudesse gravar
    // aqui, zerar o próprio limite (e a conta da OpenAI do box) seria trivial —
    // por isso o contador não mora em nutricao/{email}, que ele edita.
    //  - o ALUNO lê o seu, para a tela mostrar quantas análises sobram;
    //  - o COACH (ehCoach) lê, para enxergar consumo.
    match /nutricaoUso/{email} {
      allow read: if request.auth != null && request.auth.token.email.lower() == email.lower();
      allow read: if ehCoach();
      allow write: if false;
    }

    // Diário de Evolução (app mobile) — uma foto por dia, permanente.
    //   diario/{email}              o aceite do diário: { aceite: { versao, aceitoEm } }
    //   diario/{email}/fotos/{dia}  a foto do dia, id == 'AAAA-MM-DD'
    // As imagens ficam no Storage (diario/{email}/{dia}.webp e {dia}_mini.webp);
    // aqui só as URLs. O aviso ao coach vai em portalInbox/{email}.diario, que a
    // regra da caixa já cobre.
    //  - o ALUNO cria/edita/apaga só o seu (refazer a foto do dia é um update);
    //  - o COACH (ehCoach) só LÊ: o diário é do aluno, nem o coach reescreve.
    // Os campos são fechados: nada além do que o app grava, nos tamanhos dele.
    // E-mail comparado em minúsculas dos dois lados (como em metas_aluno): os
    // clientes gravam o id em minúsculas, e um login "Aluno@…" não pode ser barrado.
    function ehAlunoDono(email) {
      return request.auth != null && request.auth.token.email.lower() == email.lower();
    }

    function aceiteDiarioValido() {
      let d = request.resource.data;
      return d.keys().hasOnly(['aceite'])
        && d.aceite is map
        && d.aceite.keys().hasAll(['versao', 'aceitoEm'])
        && d.aceite.keys().hasOnly(['versao', 'aceitoEm'])
        && d.aceite.versao is string && d.aceite.versao.size() > 0 && d.aceite.versao.size() <= 10
        && d.aceite.aceitoEm is number && d.aceite.aceitoEm > 0;
    }

    // As duas URLs têm de ser download URLs do nosso bucket, na pasta diario/ e
    // no arquivo DESTE dia — o coach abre esse link, então não pode ser um
    // endereço qualquer. `[.]` em vez de `\\.` só para o regex ficar legível.
    function urlDiarioValida(url, dia, sufixo) {
      return url is string && url.size() <= 1024
        && url.matches('https://firebasestorage[.]googleapis[.]com/v0/b/projeto-garage-f0a2f[.]firebasestorage[.]app/o/diario%2F[^/?]+%2F'
          + dia + sufixo + '[.]webp[?].*');
    }

    function fotoDiarioValida(dia) {
      let d = request.resource.data;
      return dia.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && d.keys().hasAll(['dia', 'em', 'url', 'miniUrl', 'largura', 'altura', 'origem'])
        && d.keys().hasOnly(['dia', 'em', 'url', 'miniUrl', 'largura', 'altura', 'origem', 'nota'])
        && d.dia == dia
        && d.em is number && d.em > 0
        && urlDiarioValida(d.url, dia, '')
        && urlDiarioValida(d.miniUrl, dia, '_mini')
        && d.largura is number && d.largura > 0 && d.largura <= 4096
        && d.altura is number && d.altura > 0 && d.altura <= 4096
        && d.origem in ['app', 'portal']
        && (!('nota' in d) || (d.nota is string && d.nota.size() > 0 && d.nota.size() <= 140));
    }

    match /diario/{email} {
      allow read: if ehAlunoDono(email) || ehCoach();
      allow create, update: if ehAlunoDono(email) && aceiteDiarioValido();
      allow delete: if ehAlunoDono(email);

      match /fotos/{dia} {
        allow read: if ehAlunoDono(email) || ehCoach();
        allow create, update: if ehAlunoDono(email) && fotoDiarioValida(dia);
        allow delete: if ehAlunoDono(email);
      }
    }

    // Caixa de entrada do aluno → coach (foto nova + feedbacks pós-treino).
    //  - o ALUNO lê/escreve apenas a própria caixa (id == e-mail logado);
    //  - o COACH (ehCoach) lê e limpa (merge para gestao/{uid}).
    match /portalInbox/{email} {
      allow read, write: if request.auth != null && request.auth.token.email.lower() == email.lower();
      allow read, write: if ehCoach();
    }

    // Aparelho do aluno (app mobile): o Expo Push Token que o app grava para
    // receber o push do chat. Quem envia é a Cloud Function
    // notificarRespostaDoCoach (Admin SDK, não passa por aqui).
    //
    // Meus Recordes (app mobile, Etapa 16.1): alunos/{email}/prs/{id}, um PR por
    // documento, id gerado no aparelho. O app só cria e apaga — sem edição.
    // Os campos são fechados, nos mesmos limites do validarPR (core/prs.ts);
    // a data depois de hoje quem barra é o app — aqui só o formato.
    function prValido() {
      let d = request.resource.data;
      return d.keys().hasOnly(['exercicio', 'carga', 'reps', 'data', 'criadoEm'])
        && d.exercicio is string && d.exercicio.size() > 0 && d.exercicio.size() <= 60
        && d.carga is number && d.carga > 0 && d.carga <= 500
        && d.reps is int && d.reps >= 1 && d.reps <= 50
        && d.data is string && d.data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.criadoEm is number && d.criadoEm > 0;
    }

    match /alunos/{email} {
      allow read, write: if ehAlunoDono(email) || ehCoach();

      match /prs/{id} {
        allow read, delete: if ehAlunoDono(email) || ehCoach();
        allow create: if (ehAlunoDono(email) || ehCoach()) && prValido();
        allow update: if false;
      }
    }

    // Mural de Recordes do coach (Etapa 16.2): os PRs de todos os alunos numa
    // consulta só — collectionGroup('prs'). O documento alunos/{email} pode nem
    // existir (a subcoleção vive sem ele), então listar `alunos` e descer em
    // cada um perderia gente. Consulta de grupo só passa por regra com
    // {path=**}; esta é só leitura e só do coach — criar e apagar continuam no
    // bloco de cima, com o caminho completo.
    match /{path=**}/prs/{id} {
      allow read: if ehCoach();
    }

    // Chat Coach ↔ Aluno (app mobile, Etapa 14):
    //   chats/{email}                 o resumo da conversa (última mensagem), para a Gestão listar
    //   chats/{email}/mensagens/{id}  uma mensagem: { texto, remetente, timestamp }
    //  - o ALUNO lê a conversa dele e escreve só como 'aluno';
    //  - o COACH (ehCoach) lê todas e escreve só como 'coach';
    //  - padrão WhatsApp (Etapa 15.2), por update:
    //      quem ESCREVEU edita o texto (editado: true);
    //      quem RECEBEU marca status 'entregue' / 'lido', e o status só avança;
    //      ninguém mexe em remetente nem timestamp.
    //  - apagar de verdade (Etapa 17.1): os DOIS lados da conversa apagam
    //    documento — a mensagem, ou a conversa inteira ("Limpar conversa" leva
    //    as mensagens do coach também) e o resumo junto. Apagar é só delete: o
    //    apagar por update da 15.2 (texto '', apagado: true) saiu quando a
    //    Central migrou (Etapa 17.1, web).
    //  - mídia (Etapa 17.2): foto, vídeo e voz. O arquivo sobe antes ao Storage
    //    (chats/{email}/{timestamp}_{tipo}.{ext}, ver storage.rules) e a
    //    mensagem nasce com `tipo`, `mediaUrl`, `duracao` (vídeo e áudio) e, no
    //    vídeo, `thumbUrl` (a capa). O `texto` continua obrigatório: na mídia é
    //    o rótulo ("📷 Foto"), que o resumo e o push mostram. Mensagem de texto
    //    vem sem `tipo` (ausente é 'texto') e sem nenhum campo de mídia.
    // Os campos são fechados: nada além do que o app grava, nos tamanhos dele.
    function mensagemChatValida(email) {
      let d = request.resource.data;
      return d.keys().hasOnly(['texto', 'remetente', 'timestamp', 'tipo', 'mediaUrl', 'duracao', 'thumbUrl'])
        && d.texto is string && d.texto.size() > 0 && d.texto.size() <= 1000
        && d.timestamp is number && d.timestamp > 0
        && midiaDaMensagemValida(d)
        && ((ehAlunoDono(email) && d.remetente == 'aluno')
          || (ehCoach() && d.remetente == 'coach'));
    }

    // Os endereços da mídia têm de ser download URLs do nosso bucket, na pasta
    // chats/ — quem recebe abre esse link, então não pode ser um endereço
    // qualquer (mesmo cuidado de urlDiarioValida).
    function urlChatValida(url) {
      return url is string && url.size() <= 2048
        && url.matches('https://firebasestorage[.]googleapis[.]com/v0/b/projeto-garage-f0a2f[.]firebasestorage[.]app/o/chats%2F[^/?]+%2F[^/?]+[?].*');
    }

    // Texto: nenhum campo de mídia. Mídia: `mediaUrl` obrigatório; `duracao`
    // (segundos) só no vídeo e no áudio, até o teto do app mais a folga que o
    // validarMidia dá (LIMITES_MIDIA em core/chat.ts: 3 min e 5 min, + 0,5 s);
    // `thumbUrl` só no vídeo.
    function midiaDaMensagemValida(d) {
      let tipo = d.get('tipo', 'texto');
      return tipo in ['texto', 'imagem', 'video', 'audio']
        && (tipo == 'texto'
          ? !d.keys().hasAny(['mediaUrl', 'duracao', 'thumbUrl'])
          : urlChatValida(d.mediaUrl)
            && (!('duracao' in d)
              || (tipo != 'imagem' && d.duracao is number && d.duracao > 0
                && d.duracao <= (tipo == 'video' ? 180.5 : 300.5)))
            && (!('thumbUrl' in d) || (tipo == 'video' && urlChatValida(d.thumbUrl))));
    }

    // Quem está logado é quem escreveu a mensagem (lado == 'aluno' | 'coach').
    function ladoDe(email, lado) {
      return (lado == 'aluno' && ehAlunoDono(email)) || (lado == 'coach' && ehCoach());
    }

    // Quem escreveu troca o texto (editado: true) — e só isso: apagar é delete.
    // A apagada da 15.2 (apagado: true) que ainda existir em conversa antiga
    // não volta por edição; ela só sai de vez, por delete. Mídia não se edita
    // (o texto dela é o rótulo): como o podeEditar do app, só mensagem de texto.
    function alteracaoDoAutor(email) {
      let antes = resource.data;
      let d = request.resource.data;
      return ladoDe(email, antes.remetente)
        && antes.get('apagado', false) != true
        && antes.get('tipo', 'texto') == 'texto'
        && d.diff(antes).affectedKeys().hasOnly(['texto', 'editado'])
        && d.texto is string && d.texto.size() > 0 && d.texto.size() <= 1000
        && d.editado == true;
    }

    // Quem recebeu mexe só no status, e ele só avança: enviado → entregue → lido.
    function recebimentoDoDestinatario(email) {
      let antes = resource.data;
      let d = request.resource.data;
      return ladoDe(email, antes.remetente == 'aluno' ? 'coach' : 'aluno')
        && d.diff(antes).affectedKeys().hasOnly(['status'])
        && (d.status == 'lido'
          || (d.status == 'entregue' && antes.get('status', 'enviado') == 'enviado'));
    }

    match /chats/{email} {
      allow read: if ehAlunoDono(email) || ehCoach();
      allow create, update: if (ehAlunoDono(email) || ehCoach())
        && request.resource.data.keys().hasOnly(['aluno', 'ultimaMensagem', 'atualizadoEm']);
      allow delete: if ehAlunoDono(email) || ehCoach();

      match /mensagens/{id} {
        allow read: if ehAlunoDono(email) || ehCoach();
        allow create: if mensagemChatValida(email);
        allow update: if alteracaoDoAutor(email) || recebimentoDoDestinatario(email);
        allow delete: if ehAlunoDono(email) || ehCoach();
      }
    }

    // Portal do Aluno em React (portal-aluno-web) — coleções só dele, um doc por
    // aluno, id == e-mail. O aluno lê e grava apenas o próprio documento; o COACH
    // (ehCoach) só lê, para a gestão acompanhar o progresso.
    //
    // A comparação é em minúsculas dos DOIS lados (e não o `==` direto do
    // ehAlunoDono): o portal grava o id sempre minúsculo, e assim um e-mail
    // cadastrado com maiúscula no Auth não fica trancado fora do próprio doc.
    // Sem `token.email` (login sem e-mail), a leitura do campo falha e nega.

    // Metas do aluno: mapa `objetivos[id]` (services/goalsService.ts do portal).
    match /metas_aluno/{email} {
      allow read, write: if request.auth != null && request.auth.token.email.lower() == email.lower();
      allow read: if ehCoach();
    }

    // Gamificação do aluno: XP e medalhas desbloqueadas.
    // Quem grava é a Cloud Function `calcularConquistasXP*` (functions/src/index.ts),
    // com o Admin SDK, que não passa por estas regras. O ALUNO só LÊ: se pudesse
    // gravar, daria XP e medalhas a si mesmo pelo console do navegador. O COACH
    // lê e grava (correção manual; a função recalcula o XP no próximo disparo).
    match /conquistas_aluno/{email} {
      allow read: if request.auth != null && request.auth.token.email.lower() == email.lower();
      allow read, write: if ehCoach();
    }
  }
}
